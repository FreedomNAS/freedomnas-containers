. /mnt/app/.env
ROCKET_ADDRESS=0.0.0.0
ROCKET_PORT=8000
DATA_FOLDER=/var/db/vaultwarden
SIGNUPS_ALLOWED=$SIGNUPS
export ROCKET_ADDRESS ROCKET_PORT DATA_FOLDER SIGNUPS_ALLOWED ADMIN_TOKEN TZ
if [ "$HTTPS" = true ]; then
	ROCKET_TLS='{certs="/mnt/app/tls/cert.pem",key="/mnt/app/tls/key.pem"}'
	export ROCKET_TLS
fi
