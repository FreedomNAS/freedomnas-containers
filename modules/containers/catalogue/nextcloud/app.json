{
  "id": "nextcloud",
  "name": "Nextcloud",
  "description": "Your own cloud: files, calendars, contacts and photos, synced to your phone and computers.",
  "website": "https://nextcloud.com",
  "web": {"port": "PORT", "inner": {"linux": 80, "freebsd": 80}, "service": "app", "behind_env": {"WEB_PROXIES": "172.16.0.0/12"}},
  "settings": [
    {"key": "PORT", "label": "Web port", "type": "port", "default": "8088"},
    {"key": "ADMIN_USER", "label": "Administrator", "type": "text", "default": "admin"},
    {"key": "ADMIN_PASSWORD", "label": "Administrator password", "type": "password", "show": true},
    {"key": "TRUSTED_DOMAINS", "label": "Addresses", "type": "hosts",
     "hint": "The names and addresses Nextcloud answers to, separated by spaces."},
    {"key": "DATA", "label": "Data folder", "type": "folder", "default": "./data", "owner": {"linux": "33:33", "freebsd": "80:80"}, "empty": true,
     "hint": "Where Nextcloud keeps everyone's files: inside the app, or an empty or new folder of your pool, e.g. /tank/nextcloud. Files already in a folder do not show up in Nextcloud."},
    {"key": "SHARES", "label": "Shares", "type": "shares", "access": "write", "account": {"linux": "33", "freebsd": "80"},
     "hint": "The group shares of the NAS Nextcloud shows as External storage, to read and write."},
    {"key": "DB_PASSWORD", "type": "secret"},
    {"key": "DB_ROOT_PASSWORD", "type": "secret"},
    {"key": "TZ", "label": "Time zone", "type": "timezone"}
  ],
  "fixed": {"NEXTCLOUD_VERSION": "35.0.2"},
  "data_version": {"file": "./html/version.php", "pattern": "OC_VersionString = '([0-9.]+)'", "key": "NEXTCLOUD_VERSION"},
  "share_mounts": {
    "linux": {"#@shares": "      - {path}:/shares/{name}"},
    "freebsd": {"#@shares": "      - share-{name}: /shares/{name}", "#@share-volumes": "  share-{name}:\n    device: {path}"}
  },
  "scripts": {"freedomnas-move.sh": ["./hooks/pre-upgrade", "./hooks/before-starting"],
              "freedomnas-shares.sh": ["./hooks/before-starting"]},
  "owned": [{"path": "./html", "owner": {"linux": "33:33", "freebsd": "80:80"}},
            {"setting": "DATA", "owner": {"linux": "33:33", "freebsd": "80:80"}}]
}
